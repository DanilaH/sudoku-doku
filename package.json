{
  "name": "sudoku-doku",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:yandex": "tsc --noEmit && vite build --mode yandex",
    "test": "vitest run",
    "verify:bank": "node --import tsx tools/verify-bank.ts && python3 tools/validate-bank.py && node --import tsx tools/verify-daily.ts && python3 tools/validate-daily.py && node --import tsx tools/verify-expansion.ts && python3 tools/validate-expansion.py",
    "android:sync": "npm run build:rustore && cap sync android",
    "build:rustore": "tsc --noEmit && vite build --mode rustore"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "latest",
    "vite": "8.3.4",
    "typescript": "^5.9.0",
    "vitest": "latest",
    "tsx": "latest",
    "@playwright/test": "latest"
  }
}
